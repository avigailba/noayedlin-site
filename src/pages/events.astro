---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';
import { byDate, isPast } from '../lib/events';

const allEvents = await getCollection('events');

const PAST_VISIBLE = 6;
const upcoming = allEvents.filter(e => !isPast(e)).sort(byDate);
const past = allEvents.filter(e => isPast(e)).sort((a, b) => byDate(b, a));
---

<Layout title="Events &amp; Lectures" lang="en">

  <PageHeading eyebrow="Events" title="Lectures & events" subtitle="Upcoming talks, readings, and public appearances." />

  {allEvents.length === 0 ? (
    <div class="ev-container">
      <p class="ev-empty">Upcoming dates will appear here. Check back soon.</p>
    </div>
  ) : (
    <div class="ev-container">

      {upcoming.length > 0 && (
        <div class="ev-grid">
          {upcoming.map((event) => <EventCard event={event} />)}
        </div>
      )}

      {past.length > 0 && (
        <>
          <div class="ev-past-head">
            <h2>Past events</h2>
            <span class="count">{past.length} {past.length === 1 ? 'event' : 'events'}</span>
          </div>
          <div class="ev-grid ev-grid--past">
            {past.slice(0, PAST_VISIBLE).map((event) => <EventCard event={event} variant="past" />)}
          </div>
          {past.length > PAST_VISIBLE && (
            <details class="ev-past-more">
              <summary class="btn-secondary">Show all past events</summary>
              <div class="ev-grid">
                {past.slice(PAST_VISIBLE).map((event) => <EventCard event={event} variant="past" />)}
              </div>
            </details>
          )}
        </>
      )}

    </div>
  )}

</Layout>

<style>
  .ev-empty {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-muted);
    margin-top: 3rem;
    text-align: center;
  }
</style>
